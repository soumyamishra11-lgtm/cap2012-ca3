#include <vector>
using namespace std;

class MyCircularQueue {
private:
    vector<int> numbers;
    int frontIndex;
    int count;

public:
    MyCircularQueue(int k) {
        numbers.resize(k);
        frontIndex = 0;
        count = 0;
    }

    bool enQueue(int value) {
        if (isFull()) {
            return false;
        }

        int backIndex = (frontIndex + count) % numbers.size();
        numbers[backIndex] = value;
        count++;

        return true;
    }

    bool deQueue() {
        if (isEmpty()) {
            return false;
        }

        frontIndex = (frontIndex + 1) % numbers.size();
        count--;

        return true;
    }

    int Front() {
        if (isEmpty()) return -1;
        return numbers[frontIndex];
    }

    int Rear() {
        if (isEmpty()) return -1;

        int backIndex = (frontIndex + count - 1) % numbers.size();
        return numbers[backIndex];
    }

    bool isEmpty() {
        return count == 0;
    }

    bool isFull() {
        return count == numbers.size();
    }
};
