#include <vector>
using namespace std;

class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int nextPosition = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != 0) {
                nums[nextPosition] = nums[i];
                nextPosition++;
            }
        }

        while (nextPosition < nums.size()) {
            nums[nextPosition] = 0;
            nextPosition++;
        }
    }
};
