#include <stack>
#include <string>
using namespace std;

class Solution {
public:
    bool isValid(string s) {
        stack<char> brackets;

        for (int i = 0; i < s.size(); i++) {
            char ch = s[i];

            if (ch == '(' || ch == '[' || ch == '{') {
                brackets.push(ch);
            } 
            else {
                if (brackets.empty()) {
                    return false;
                }

                char opening = brackets.top();
                brackets.pop();

                if (ch == ')' && opening != '(') return false;
                if (ch == ']' && opening != '[') return false;
                if (ch == '}' && opening != '{') return false;
            }
        }

        return brackets.empty();
    }
};
